    },
    {
      "module": "message-loader.js",
      "globals": [
        "state",
        "supabaseClient"
      ],
      "reason": "Message lifecycle module uses the shared application state and backend client."
    },
    {
      "module": "profile-status-and-conversation-images.js",
      "globals": [
        "state",
        "supabaseClient",
        "toast"
      ],
      "reason": "Existing shared-state and service coupling; lifecycle contract to be hardened."
    },
    {
      "module": "status-workspace.js",
      "globals": [
        "state",
        "supabaseClient",
        "toast"
      ],
      "reason": "Existing shared-state and service coupling; lifecycle contract to be hardened."
    }
  ]
}
