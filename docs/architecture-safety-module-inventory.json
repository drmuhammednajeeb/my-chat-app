{
  "modules": [
    "app-updater.js",
    "audio-player.js",
    "auth-error-messages.js",
    "auth-light.js",
    "backup-restore.js",
    "message-loader.js",
    "message-reactions.js",
    "profile-status-and-conversation-images.js",
    "runtime-config.js",
    "status-workspace.js",
    "voice-recorder.js",
    "password-strength.js",
    "signup-name-validation.js"
  ],
  "implicitGlobals": [
    {
      "module": "backup-restore.js",
      "globals": [
        "state",
        "supabaseClient",
        "toast"
